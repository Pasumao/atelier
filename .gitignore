# Atelier workspace — minimal ignore (decision 15: source checkpoints need a clean tree)
node_modules/
.dsh/
.dsh-trash/
*.tmpdir
.edge-debug*
*.log
prototype/dist/

# M3 arm-run scratch (RUNBOOK: attempt dirs are trash, graded facts live in results/)
.m3-runs/

# M3 grading artifacts (grade.mjs 落盘产物：含本机路径/时间戳，每次评分都刷新，不入库)
atelier/benchmarks/m3/**/m3-grade.json

# M3 arm-run leftover copies (react-tpl 等 attempt 拷贝，同 .m3-runs/ 纪律)
DAgentic.m3-runs_react-tpl/
# 本地工作区状态：checkpoint 时间线不入公共库；api-surface.json 例外——CI api-diff 门禁（0516054）
# 在干净 checkout 上需要基线，untrack 它会让 matrix 四组合全红（2026-09-06 实证）
.atelier/*
!.atelier/api-surface.json

# FS-M2 多智能体协作 worktrees（主智能体编排用；分支合并回 main 后可删）
.worktrees/

# snapshot 瞬态捕获不入库（m10 批 C：per-platform 基线 baseline*.png 入库，current*.png 是 check 的瞬态产物——
# 含 per-platform/current-full.png 变体，P-D#3 起通配 `current*` 防瞬态捕获进锚点提交）
.atr/snapshots/**/current*.png
